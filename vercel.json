{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend"
    }
  },
  "crons": [
    {
      "path": "/api/admin/silver-rate",
      "schedule": "5 4 * * *"
    },
    {
      "path": "/api/admin/silver-rate",
      "schedule": "5 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/backend/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/rates",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
